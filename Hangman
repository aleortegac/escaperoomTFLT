    <script>
        /* ===================================================================
           GAME DATASET (DEI & MODAL VERBS)
           =================================================================== */
        const wordList = [
            {
                target: "MUSTN'T",
                category: "Anti-Bullying & Rules",
                sentence: "You ___ insult or intimidate anyone in person or online.",
                grammarHint: "Modal verb used for strict prohibition or rules.",
                deiHint: "Cyberbullying or verbal harassment is never acceptable.",
                explanation: "<b>'Mustn't'</b> expresses a strong rule or prohibition. In safe communities, harassment is strictly forbidden.",
                deiTip: "Respecting boundaries ensures that everyone feels psychologically safe."
            },
            {
                target: "RESPECT",
                category: "Core DEI Values",
                sentence: "We should show ___ for all cultural traditions and backgrounds.",
                grammarHint: "Noun following a modal verb phrase ('show respect').",
                deiHint: "Valuing other people's identities and feelings.",
                explanation: "<b>'Respect'</b> is the foundation of inclusive communication.",
                deiTip: "Showing respect means listening openly without prejudice."
            },
            {
                target: "SHOULD",
                category: "Kindness & Empathy",
                sentence: "We ___ invite classmates who are sitting alone to join our lunch table.",
                grammarHint: "Modal verb used to offer good advice or recommendations.",
                deiHint: "A proactive act of kindness to prevent isolation.",
                explanation: "<b>'Should'</b> indicates a recommended, positive course of action.",
                deiTip: "Small acts of inclusion reduce feelings of loneliness and peer exclusion."
            },
            {
                target: "EQUITY",
                category: "Diversity & Inclusion",
                sentence: "___ means giving everyone the specific tools they need to succeed.",
                grammarHint: "Key noun describing fairness rather than identical treatment.",
                deiHint: "Providing tailored support so everyone has equal opportunity.",
                explanation: "<b>'Equity'</b> ensures individuals receive support relative to their unique needs.",
                deiTip: "Equality gives everyone the same shoe; equity gives everyone a shoe that fits!"
            },
            {
                target: "ALLOW",
                category: "Rights & Accessibility",
                sentence: "Accessible ramps ___ wheelchair users to enter the building independently.",
                grammarHint: "Verb meaning to permit or make something possible.",
                deiHint: "Removing physical barriers for people with disabilities.",
                explanation: "<b>'Allow'</b> signifies granting permission or enabling full participation.",
                deiTip: "Universal design benefits the entire community, not just individuals with disabilities."
            },
            {
                target: "OUGHT TO",
                category: "Moral Responsibilities",
                sentence: "We ___ stand up for victims of discrimination whenever we see it.",
                grammarHint: "Two-word modal phrase meaning 'should' (moral duty).",
                deiHint: "An ethical obligation to be an active upstander.",
                explanation: "<b>'Ought to'</b> carries a strong tone of moral duty and social responsibility.",
                deiTip: "Upstanders use their voice to protect others from unfair treatment."
            }
        ];

        /* ===================================================================
           STATE VARIABLES
           =================================================================== */
        let playerName = "";
        let currentWordIndex = 0;
        let score = 0;
        let mistakesLeft = 6;
        let guessedLetters = new Set();
        let secondsElapsed = 0;
        let timerInterval = null;
        let activeHintType = null;
        let totalGuesses = 0;
        let correctGuesses = 0;

        /* ===================================================================
           WEB AUDIO API SYNTHESIZER
           =================================================================== */
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) audioCtx = new AudioContext();
        }

        function playSound(type) {
            if (!audioCtx) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(500, now);
                    gain.gain.setValueAtTime(0.04, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
                    osc.start(now);
                    osc.stop(now + 0.04);
                } else if (type === 'correct') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.08);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(200, now);
                    osc.frequency.setValueAtTime(140, now + 0.1);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } else if (type === 'win') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, now);
                    osc.frequency.setValueAtTime(554.37, now + 0.1);
                    osc.frequency.setValueAtTime(659.25, now + 0.2);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                    osc.start(now);
                    osc.stop(now + 0.5);
                }
            } catch (e) {
                console.error(e);
            }
        }

        /* ===================================================================
           STREAMING_CHUNK:Handling Input, Keyboard Events, and Game Engine...
           =================================================================== */
        function startGame(e) {
            e.preventDefault();
            initAudio();

            const input = document.getElementById('playerName').value.trim();
            playerName = input || "Inclusion Hero";

            document.getElementById('startScreen').classList.add('hidden');
            document.getElementById('gameScreen').classList.remove('hidden');
            document.getElementById('gameStatsHeader').classList.remove('hidden');

            score = 0;
            currentWordIndex = 0;
            secondsElapsed = 0;
            totalGuesses = 0;
            correctGuesses = 0;

            updateScoreDisplay();
            startTimer();
            renderKeyboard();
            loadWord(currentWordIndex);

            // Listen to physical keyboard events
            window.addEventListener('keydown', handlePhysicalKeyboard);
        }

        function startTimer() {
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                secondsElapsed++;
                const mins = Math.floor(secondsElapsed / 60).toString().padStart(2, '0');
                const secs = (secondsElapsed % 60).toString().padStart(2, '0');
                document.getElementById('timerDisplay').innerText = `${mins}:${secs}`;
            }, 1000);
        }

        function stopTimer() {
            clearInterval(timerInterval);
        }

        function updateScoreDisplay() {
            document.getElementById('scoreDisplay').innerText = score;
        }

        function renderHearts() {
            const container = document.getElementById('heartsContainer');
            container.innerHTML = '';
            for (let i = 0; i < 6; i++) {
                if (i < mistakesLeft) {
                    container.innerHTML += '<i class="fa-solid fa-heart animate-pop text-rose-500"></i>';
                } else {
                    container.innerHTML += '<i class="fa-regular fa-heart text-slate-600"></i>';
                }
            }
        }

        function renderKeyboard() {
            const keyboard = document.getElementById('keyboard');
            keyboard.innerHTML = '';
            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ'".split('');

            letters.forEach(char => {
                const btn = document.createElement('button');
                btn.id = `key-${char === "'" ? 'APOS' : char}`;
                btn.className = "letter-btn py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 font-bold text-slate-100 text-sm sm:text-base border border-slate-600 shadow transition active:scale-95";
                btn.innerText = char;
                btn.onclick = () => handleGuess(char);
                keyboard.appendChild(btn);
            });
        }

        function updateBridgeVisual() {
            // Bridge SVG has 6 pieces corresponding to remaining lives
            // mistakesLeft: 6 -> All visible, 0 -> All broken/hidden
            const mistakeCount = 6 - mistakesLeft;
            
            for (let i = 1; i <= 6; i++) {
                const piece = document.getElementById(`bridge_${i}`);
                if (piece) {
                    if (i > (6 - mistakeCount)) {
                        piece.style.opacity = '0.15';
                        piece.style.filter = 'grayscale(100%)';
                    } else {
                        piece.style.opacity = '1';
                        piece.style.filter = 'none';
                    }
                }
            }

            const statusText = document.getElementById('bridgeStatusText');
            if (mistakesLeft === 6) {
                statusText.innerText = "Bridge intact! Safe crossing.";
                statusText.className = "text-xs text-center text-emerald-400 mt-2 font-semibold";
            } else if (mistakesLeft > 2) {
                statusText.innerText = `Careful! Bridge losing structural stability (${mistakesLeft} chances left).`;
                statusText.className = "text-xs text-center text-amber-400 mt-2 font-semibold";
            } else {
                statusText.innerText = `Critical condition! Only ${mistakesLeft} mistake left!`;
                statusText.className = "text-xs text-center text-rose-400 mt-2 font-bold animate-pulse";
            }
        }

        function loadWord(index) {
            const data = wordList[index];
            mistakesLeft = 6;
            guessedLetters.clear();
            activeHintType = null;
            document.getElementById('hintBox').classList.add('hidden');

            // Update Headers
            document.getElementById('wordProgressBadge').innerText = `Word ${index + 1} / ${wordList.length}`;
            document.getElementById('categoryTitle').innerHTML = `<i class="fa-solid fa-shield-halved text-pink-400"></i> Category: ${data.category}`;
            
            // Sentence setup
            document.getElementById('sentenceContext').innerText = data.sentence;

            // Reset UI
            renderHearts();
            updateBridgeVisual();

            // Enable keys
            const keys = document.querySelectorAll('.letter-btn');
            keys.forEach(k => {
                k.disabled = false;
                k.className = "letter-btn py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 font-bold text-slate-100 text-sm sm:text-base border border-slate-600 shadow transition active:scale-95";
            });

            renderWordSlots();
        }

        function renderWordSlots() {
            const data = wordList[currentWordIndex];
            const wordDisplay = document.getElementById('wordDisplay');
            wordDisplay.innerHTML = '';

            const characters = data.target.split('');

            characters.forEach(char => {
                const box = document.createElement('div');
                
                if (char === ' ') {
                    box.className = "w-4 h-12"; // Space spacer
                } else {
                    box.className = "w-8 h-11 sm:w-10 sm:h-12 rounded-xl bg-slate-900 border-2 border-slate-700 flex items-center justify-center font-black text-lg sm:text-xl text-white shadow-inner";
                    
                    if (guessedLetters.has(char) || char === ' ' || char === '-') {
                        box.innerText = char;
                        box.classList.add('border-purple-500', 'text-purple-300', 'bg-purple-950/30', 'animate-pop');
                    } else {
                        box.innerText = '_';
                        box.classList.add('text-slate-600');
                    }
                }
                wordDisplay.appendChild(box);
            });
        }

        function handlePhysicalKeyboard(e) {
            if (document.getElementById('gameScreen').classList.contains('hidden')) return;
            if (!document.getElementById('feedbackModal').classList.contains('hidden')) return;

            const key = e.key.toUpperCase();
            if ((key >= 'A' && key <= 'Z') || key === "'") {
                handleGuess(key);
            }
        }

        function handleGuess(letter) {
            if (guessedLetters.has(letter) || mistakesLeft <= 0) return;

            guessedLetters.add(letter);
            totalGuesses++;

            const btnId = `key-${letter === "'" ? 'APOS' : letter}`;
            const btn = document.getElementById(btnId);

            const data = wordList[currentWordIndex];
            const isCorrect = data.target.includes(letter);

            if (isCorrect) {
                playSound('correct');
                correctGuesses++;
                if (btn) {
                    btn.disabled = true;
                    btn.className = "letter-btn py-2.5 rounded-lg bg-emerald-600 font-bold text-white text-sm sm:text-base border border-emerald-500 shadow";
                }
                renderWordSlots();
                checkWordComplete();
            } else {
                playSound('wrong');
                mistakesLeft--;
                if (btn) {
                    btn.disabled = true;
                    btn.className = "letter-btn py-2.5 rounded-lg bg-rose-900/60 font-bold text-rose-300 text-sm sm:text-base border border-rose-700 opacity-60";
                }
                renderHearts();
                updateBridgeVisual();

                if (mistakesLeft <= 0) {
                    // Out of attempts for this word
                    showFeedback(false);
                }
            }
        }

        function toggleHint(type) {
            playSound('click');
            const data = wordList[currentWordIndex];
            const hintBox = document.getElementById('hintBox');
            const hintText = document.getElementById('hintText');

            if (activeHintType === type) {
                hintBox.classList.add('hidden');
                activeHintType = null;
            } else {
                activeHintType = type;
                hintBox.classList.remove('hidden');
                if (type === 'grammar') {
                    hintText.innerHTML = `<strong class="text-indigo-400"><i class="fa-solid fa-book"></i> Grammar Hint:</strong> ${data.grammarHint}`;
                } else {
                    hintText.innerHTML = `<strong class="text-pink-400"><i class="fa-solid fa-heart"></i> DEI Context Hint:</strong> ${data.deiHint}`;
                }
            }
        }

        function checkWordComplete() {
            const data = wordList[currentWordIndex];
            const chars = data.target.split('');
            const allGuessed = chars.every(c => c === ' ' || c === '-' || guessedLetters.has(c));

            if (allGuessed) {
                // Award points: 150 base + 25 per remaining mistake
                const roundPoints = 150 + (mistakesLeft * 25);
                score += roundPoints;
                updateScoreDisplay();
                playSound('win');

                showFeedback(true);
            }
        }

        /* ===================================================================
           EDUCATIONAL FEEDBACK & GAME PROGRESSION
           =================================================================== */
        function showFeedback(won) {
            const data = wordList[currentWordIndex];
            const modal = document.getElementById('feedbackModal');
            const card = document.getElementById('feedbackCard');
            const iconContainer = document.getElementById('feedbackIconContainer');
            const title = document.getElementById('feedbackTitle');
            const content = document.getElementById('feedbackContent');

            if (won) {
                card.className = "max-w-md w-full bg-slate-800 border-2 border-emerald-500/50 rounded-2xl p-6 shadow-2xl transform transition-all scale-100 opacity-100";
                iconContainer.className = "w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl font-bold border border-emerald-500/30";
                iconContainer.innerHTML = '<i class="fa-solid fa-bridge-circle-check"></i>';
                title.innerText = `Bridge Preserved: "${data.target}"`;
                title.className = "text-lg font-extrabold text-emerald-400";
            } else {
                card.className = "max-w-md w-full bg-slate-800 border-2 border-rose-500/50 rounded-2xl p-6 shadow-2xl transform transition-all scale-100 opacity-100";
                iconContainer.className = "w-10 h-10 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center text-xl font-bold border border-rose-500/30";
                iconContainer.innerHTML = '<i class="fa-solid fa-bridge-circle-exclamation"></i>';
                title.innerText = `The Target Word was "${data.target}"`;
                title.className = "text-lg font-extrabold text-rose-400";
            }

            content.innerHTML = `
                <p class="mb-2"><strong class="text-white">Completed Context:</strong></p>
                <p class="text-xs italic bg-slate-950/60 p-2.5 rounded border border-slate-700/60 text-purple-200 mb-3">
                    "${data.sentence.replace('___', `<span class="underline font-bold text-amber-300">${data.target}</span>`)}"
                </p>
                <p class="mb-2"><strong class="text-white">Grammar Explanation:</strong> ${data.explanation}</p>
                <div class="p-3 bg-purple-950/40 border border-purple-500/30 rounded-lg text-xs text-purple-200">
                    <strong class="text-purple-300 block mb-1"><i class="fa-solid fa-heart"></i> Inclusion Tip:</strong>
                    ${data.deiTip}
                </div>
            `;

            modal.classList.remove('hidden');
        }

        function closeFeedbackModal() {
            document.getElementById('feedbackModal').classList.add('hidden');

            if (currentWordIndex < wordList.length - 1) {
                currentWordIndex++;
                loadWord(currentWordIndex);
            } else {
                finishGame();
            }
        }

        /* ===================================================================
           FINAL CERTIFICATE & RESTART
           =================================================================== */
        function finishGame() {
            stopTimer();
            window.removeEventListener('keydown', handlePhysicalKeyboard);
            playSound('win');

            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 130,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }

            document.getElementById('gameScreen').classList.add('hidden');
            document.getElementById('summaryScreen').classList.remove('hidden');

            document.getElementById('certPlayerName').innerText = playerName;
            document.getElementById('finalScore').innerText = score;
            document.getElementById('finalTime').innerText = document.getElementById('timerDisplay').innerText;

            const accuracyVal = totalGuesses > 0 ? Math.round((correctGuesses / totalGuesses) * 100) : 100;
            document.getElementById('finalAccuracy').innerText = `${accuracyVal}%`;

            // Badges logic
            const badgesContainer = document.getElementById('badgesContainer');
            badgesContainer.innerHTML = '';

            const badges = [
                { title: "Bridge Builder", icon: "fa-person-bridge-crossing", color: "from-purple-500 to-indigo-500", condition: true },
                { title: "DEI Upstander", icon: "fa-hand-holding-heart", color: "from-pink-500 to-rose-500", condition: score >= 600 },
                { title: "Grammar Tactician", icon: "fa-graduation-cap", color: "from-emerald-500 to-teal-500", condition: accuracyVal >= 75 },
                { title: "Swift Solver", icon: "fa-stopwatch", color: "from-amber-500 to-yellow-500", condition: secondsElapsed < 180 }
            ];

            badges.forEach(b => {
                if (b.condition) {
                    const badgeElem = document.createElement('div');
                    badgeElem.className = `flex items-center gap-2 px-3 py-2 rounded-xl bg-gradient-to-r ${b.color} text-white font-bold text-xs shadow-md`;
                    badgeElem.innerHTML = `<i class="fa-solid ${b.icon}"></i> <span>${b.title}</span>`;
                    badgesContainer.appendChild(badgeElem);
                }
            });
        }

        function restartGame() {
            document.getElementById('summaryScreen').classList.add('hidden');
            document.getElementById('startScreen').classList.remove('hidden');
            document.getElementById('gameStatsHeader').classList.add('hidden');
        }

        function printCertificate() {
            window.print();
        }
    </script>
</body>
</html>
